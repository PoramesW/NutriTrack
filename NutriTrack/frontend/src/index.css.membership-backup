
/* ========================================
   NutriTrack Membership Pages
======================================== */

.membership-page {
  min-height: 100vh;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  background:
    radial-gradient(circle at 10% 10%, rgba(57, 160, 112, 0.10), transparent 35%),
    linear-gradient(135deg, #f2f8f4 0%, #f7faf8 55%, #edf5f0 100%);
}

.membership-card {
  width: 100%;
  max-width: 460px;
  padding: 42px;
  background: #ffffff;
  border: 1px solid #e6eee8;
  border-radius: 22px;
  box-shadow: 0 18px 55px rgba(31, 75, 51, 0.09);
}

.membership-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 32px;
  color: #243c30;
  font-size: 23px;
  font-weight: 800;
  text-decoration: none;
}

.membership-brand-mark {
  display: flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #218356;
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.membership-eyebrow {
  margin: 0 0 9px;
  color: #218356;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.7px;
  text-align: center;
}

.membership-title {
  margin: 0;
  color: #24352b;
  font-size: 29px;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.membership-description {
  margin: 12px 0 30px;
  color: #7b8980;
  font-size: 14px;
  line-height: 1.7;
  text-align: center;
}

.membership-form {
  display: flex;
  flex-direction: column;
  gap: 21px;
}

.membership-field {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.membership-field label {
  color: #34483b;
  font-size: 13px;
  font-weight: 700;
}

.membership-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.membership-label-row a,
.membership-switch a {
  color: #218356;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.membership-label-row a:hover,
.membership-switch a:hover {
  color: #176642;
  text-decoration: underline;
}

.membership-field input {
  width: 100%;
  min-width: 0;
  height: 49px;
  padding: 0 14px;
  border: 1px solid #dce6df;
  border-radius: 10px;
  outline: none;
  background: #fbfdfb;
  color: #263b2e;
  font-family: inherit;
  font-size: 14px;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
}

.membership-field input::placeholder {
  color: #a6b1aa;
}

.membership-field input:focus {
  border-color: #39996c;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(57, 153, 108, 0.12);
}

.membership-password-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.membership-password-wrap input {
  padding-right: 70px;
}

.membership-password-toggle {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  padding: 6px 7px;
  border: none;
  background: transparent;
  color: #218356;
  font-family: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.membership-password-toggle:hover {
  color: #145c3a;
}

.membership-password-toggle:focus-visible {
  outline: 2px solid #39996c;
  outline-offset: 2px;
  border-radius: 4px;
}

.membership-hint {
  color: #94a198;
  font-size: 11px;
}

.membership-submit {
  width: 100%;
  min-height: 49px;
  margin-top: 3px;
  border: none;
  border-radius: 10px;
  background: #218356;
  color: #ffffff;
  font-family: inherit;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
}

.membership-submit:hover:not(:disabled) {
  background: #176b45;
  box-shadow: 0 5px 15px rgba(33, 131, 86, 0.2);
  transform: translateY(-1px);
}

.membership-submit:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.membership-switch {
  margin: 27px 0 0;
  color: #849087;
  font-size: 13px;
  text-align: center;
}

.membership-message {
  margin: 0;
  padding: 11px 13px;
  border-radius: 9px;
  font-size: 13px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.membership-error {
  border: 1px solid #f1cece;
  background: #fff5f5;
  color: #bd4545;
}

.membership-success {
  border: 1px solid #cce8d6;
  background: #f0faf3;
  color: #287a4c;
}

.membership-demo-link {
  padding: 14px;
  border: 1px solid #dcebe1;
  border-radius: 10px;
  background: #f5faf6;
  color: #496252;
  font-size: 13px;
  overflow-wrap: anywhere;
}

.membership-demo-link strong {
  color: #218356;
}

.membership-demo-link p {
  margin: 6px 0 10px;
}

.membership-demo-link a {
  color: #218356;
  font-weight: 800;
  text-decoration: none;
}

.membership-demo-link a:hover {
  text-decoration: underline;
}

@media (max-width: 520px) {
  .membership-page {
    padding: 22px 15px;
  }

  .membership-card {
    padding: 32px 23px;
    border-radius: 18px;
  }

  .membership-title {
    font-size: 25px;
  }

  .membership-brand {
    margin-bottom: 27px;
  }
}
