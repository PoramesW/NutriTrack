
/* Welcome Page */
.welcome-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30px 20px;
  background: #f6f8f6;
}

.welcome-card {
  width: 100%;
  max-width: 620px;
  padding: 55px 45px;
  background: #ffffff;
  border: 1px solid #e5ece7;
  border-radius: 20px;
  text-align: center;
  box-shadow: 0 12px 40px rgba(32, 70, 48, 0.06);
}

.welcome-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 45px;
  color: #218356;
  font-size: 22px;
  font-weight: 800;
}

.welcome-brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #218356;
  color: #fff;
}

.welcome-eyebrow {
  color: #218356;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
}

.welcome-card h1 {
  margin: 18px 0;
  color: #202b26;
  font-size: clamp(34px, 6vw, 48px);
  line-height: 1.15;
}

.welcome-description {
  max-width: 440px;
  margin: 0 auto;
  color: #788780;
  font-size: 15px;
  line-height: 1.8;
}

.welcome-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 32px;
}

.welcome-actions a {
  min-width: 150px;
  text-decoration: none;
}

.welcome-footer {
  margin-top: 40px;
  color: #9aa69f;
  font-size: 12px;
}

@media (max-width: 480px) {
  .welcome-card {
    padding: 40px 22px;
  }

  .welcome-actions {
    flex-direction: column;
  }

  .welcome-actions a {
    width: 100%;
  }
}
